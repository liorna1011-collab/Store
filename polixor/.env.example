# ==========================================================================
#  Polixor – משתני סביבה לדוגמה
#  העתק לקובץ .env ושנה לפי הצורך. כל המשתנים אופציונליים.
# ==========================================================================

# --- נתיבים ---
# תיקיית הנתונים (DB, וידאו, קליפים, מודלים).
# ברירת מחדל ב-Windows: %LOCALAPPDATA%\Polixor
# POLIXOR_DATA_DIR=D:\Polixor

# נתיב מפורש ל-FFmpeg אם הוא לא ב-PATH
# POLIXOR_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# POLIXOR_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# --- שרת ---
# POLIXOR_HOST=127.0.0.1
# POLIXOR_PORT=8756
# POLIXOR_LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR
# POLIXOR_RELOAD=0                # 1 = טעינה מחדש בפיתוח

# --- מפתחות API ---
# עדיף להזין אותם במסך ההגדרות: הם נשמרים מוצפנים בדיסק
# ואינם נחשפים בדפדפן. משתני הסביבה כאן גוברים על הערך השמור.
# POLIXOR_ANTHROPIC_API_KEY=sk-ant-...
# POLIXOR_OPENAI_API_KEY=sk-...

# קובץ עוגיות שייצאת בעצמך מהדפדפן, לגישה לתוכן שהחשבון שלך מורשה לצפות בו.
# Polixor אינו ניגש לדפדפן שלך ואינו עוקף DRM או הגבלות גישה.
# POLIXOR_COOKIEFILE_PATH=C:\Users\me\cookies.txt

# --- בדיקות בלבד ---
# נתיב לקובץ תמלול מוכן, לשימוש ספק הבדיקה (transcript_provider=fixture).
# אינו בשימוש בהרצה רגילה.
# POLIXOR_FIXTURE_TRANSCRIPT=C:\test\transcript.json
