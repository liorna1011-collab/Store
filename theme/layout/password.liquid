<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Newsreader:opsz,wght@6..72,400&family=JetBrains+Mono:wght@500;700&display=swap">
  {% style %}
    :root {
      --accent: {{ settings.color_accent | default: '#0C8A76' }};
      --accent-dark: {{ settings.color_accent | default: '#0C8A76' | color_darken: 7 }};
      --ink: {{ settings.color_ink | default: '#121A18' }};
      --ink-2: {{ settings.color_ink | default: '#121A18' | color_lighten: 16 }};
      --muted: {{ settings.color_ink | default: '#121A18' | color_lighten: 38 }};
      --ground: {{ settings.color_ground | default: '#F6F7F5' }};
      --surface: {{ settings.color_ground | default: '#F6F7F5' | color_lighten: 3 }};
      --surface-2: {{ settings.color_ground | default: '#F6F7F5' | color_darken: 3 }};
      --rule: {{ settings.color_ground | default: '#F6F7F5' | color_darken: 9 }};
      --rule-strong: {{ settings.color_ground | default: '#F6F7F5' | color_darken: 18 }};
      --font-display: 'Archivo', system-ui, sans-serif;
      --font-body: 'Newsreader', Georgia, serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    }
  {% endstyle %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="section" style="min-height:70vh;display:grid;place-items:center">
    <div class="wrap wrap--prose center">
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
