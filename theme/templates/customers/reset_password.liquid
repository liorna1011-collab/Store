<section class="section">
  <div class="wrap wrap--prose" style="max-width:420px">
    <h1>{{ 'customer.recover_password.title' | t }}</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="stack-sm" style="margin-top:20px">
        <label for="ResetPass">New password</label>
        <input class="btn btn--ghost btn--full" style="justify-content:flex-start" id="ResetPass" type="password" name="customer[password]" autocomplete="new-password">
        <label for="ResetPassConf">Confirm password</label>
        <input class="btn btn--ghost btn--full" style="justify-content:flex-start" id="ResetPassConf" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button class="btn btn--primary btn--full btn--lg" type="submit" style="margin-top:18px">Reset password</button>
    {% endform %}
  </div>
</section>
