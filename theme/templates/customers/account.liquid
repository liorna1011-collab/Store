<section class="section">
  <div class="wrap wrap--narrow">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <p class="muted"><a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a> · <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>

    <h2 style="margin-top:32px;font-size:1.3rem">{{ 'customer.account.orders' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <div class="tablewrap" style="margin-top:16px">
        <table class="cmp">
          <thead><tr><th>{{ 'customer.orders.order_number' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- else -%}
      <p class="muted">{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>
</section>
