<header class="header">
  <div class="header__in">
    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" height="30">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="header__nav" data-nav data-open="false" aria-label="{{ 'accessibility.main_nav' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      <button class="cart-btn" type="button" data-drawer-open aria-label="{{ 'sections.cart.title' | t }}">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 3h1.6l1.4 7.4h7l1.3-5.4H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="6.8" cy="13" r="1.1" fill="currentColor"/>
          <circle cx="11.8" cy="13" r="1.1" fill="currentColor"/>
        </svg>
        <span>Bag</span>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
