<section class="section">
  <div class="wrap">
    <div style="margin-bottom:32px">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid">
          {%- for product in collection.products -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="flow-cta" style="margin-top:36px" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="btn btn--ghost btn--sm" href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a class="btn btn--ghost btn--sm" href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">Nothing here yet.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
