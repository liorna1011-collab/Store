<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="wrap wrap--narrow">
    <div style="margin-bottom:22px">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<div class="lede rte">{{ section.settings.body }}</div>{%- endif -%}
    </div>

    <div class="acc">
      {%- for block in section.blocks -%}
        {%- assign pid = 'faq-' | append: section.id | append: '-' | append: forloop.index -%}
        <div class="acc__item" {{ block.shopify_attributes }}>
          <h3 style="margin:0">
            <button class="acc__q" type="button" aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}" aria-controls="{{ pid }}">
              {{ block.settings.question }}
            </button>
          </h3>
          <div class="acc__a rte" id="{{ pid }}"{% unless block.settings.open %} hidden{% endunless %}>
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_url != blank -%}
      <p style="margin-top:26px">
        <a class="btn btn--ghost" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "checkbox", "id": "alt", "label": "Alternate background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Straight answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you ask" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
